# --- REQUIRED in production -------------------------------------------------------
API_KEYS=change-me-long-random-string,another-key        # bearer keys; empty refuses to start unless ALLOW_ANONYMOUS=true
PUBLIC_BASE_URL=https://your-domain.example              # used to build download links
ALLOWED_HOSTS=your-domain.example                        # Host headers accepted on /mcp (DNS-rebinding guard)
ALLOW_ANONYMOUS=false    # true = serve with no credentials (local dev only -- never in production)

# --- auth mode: key (default) | oauth | either ------------------------------------
# key: bearer API_KEYS only -- works with Muse, Claude, ChatGPT, any MCP client.
# oauth: OAuth 2.1 JWT access tokens only (needs OAUTH_* below).
# either: accept both (recommended while Muse review is pending).
AUTH_MODE=key
# OAUTH_ENABLED=false
# OAUTH_ISSUER=https://accounts.example.com
# OAUTH_AUDIENCE=data-cleaner
# OAUTH_JWKS_URL=https://accounts.example.com/.well-known/jwks.json
# OAUTH_TIER_CLAIM=tier            # JWT claim naming the plan ("paid" -> full tier)
# OAUTH_REQUIRED_SCOPES=           # e.g. data:clean

# --- limits (top tier) --------------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_ROWS=200000
MAX_COLS=500
TTL_SECONDS=3600
MAX_DATASETS_PER_CLIENT=10
RATE_LIMIT_PER_MINUTE=120
ALLOW_URL_FETCH=true

# --- monetisation (see docs/monetization.md) --------------------------------------
BILLING_ENABLED=false            # false = everyone gets the paid plan
PAID_CLIENTS=                    # comma-separated client ids (k_...) treated as paying
FREE_MAX_ROWS=5000
FREE_MAX_UPLOAD_MB=2
FREE_FILES_PER_DAY=5

# --- optional model (OFF by default; if on, only redacted structure is sent) --------
LLM_ENABLED=false
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
